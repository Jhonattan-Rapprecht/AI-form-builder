<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authentication check | AI-Formbuilder</title>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <main class="auth-shell">
        <header class="auth-brand" aria-label="AI-Formbuilder">
            <span class="brand-mark">AF</span>
            <span>AI-Formbuilder</span>
        </header>

        <section class="auth-panel auth-success" aria-labelledby="admin-title">
            <p class="eyebrow">PLATFORM ACCESS VERIFIED</p>
            <h1 id="admin-title">Super Admin authentication successful.</h1>
            <p class="intro"><%= user.firstName || user.lastName ? `${user.firstName || ''} ${user.lastName || ''}`.trim() : user.email %></p>
            <form action="/logout" method="post">
                <button class="button-secondary" type="submit">Sign out</button>
            </form>
        </section>

        <footer>Temporary protected authentication check</footer>
    </main>
</body>
</html>