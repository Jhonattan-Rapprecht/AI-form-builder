<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in | AI-Formbuilder</title>
    <link rel="stylesheet" href="/css/visual-identity.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <main class="auth-shell">
        <header class="afb-wordmark auth-brand" aria-label="AI-Formbuilder">
            <span class="afb-wordmark-ai">AI</span>-Formbuilder
        </header>

        <section class="auth-panel" aria-labelledby="login-title">
            <p class="eyebrow">SECURE WORKSPACE</p>
            <h1 id="login-title">Sign in</h1>
            <p class="intro">Use your invited account to continue.</p>

            <% if (error) { %>
                <p class="message message-error" role="alert"><%= error %></p>
            <% } %>
            <% if (rateLimited) { %>
                <p class="message message-error" role="alert">Too many attempts. Please wait before trying again.</p>
            <% } %>

            <form action="/login" method="post">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required autofocus>

                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>

                <button type="submit">Sign in</button>
            </form>
        </section>

        <footer class="auth-footer">AI-Formbuilder &copy; 2026</footer>
    </main>
</body>
</html>