<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Formbuilder</title>

    <link rel="stylesheet" href="/css/construction.css">
</head>

<body>

    <main class="construction-page">

        <header class="top-bar">
            <div class="brand">
                <span class="brand-ai">AI</span>-Formbuilder
            </div>

            <div class="version">
                v1.0
            </div>
        </header>


        <section class="construction-content">

            <div class="wrench-container">
                <div class="wrench-glow"></div>

                <img
                    src="/images/wrench.png"
                    alt="AI Formbuilder under construction"
                    class="wrench"
                >
            </div>


            <div class="status">
                <span class="status-dot"></span>
                DEVELOPMENT IN PROGRESS
            </div>


            <h1>
                Something awesome<br>
                is being built.
            </h1>


            <p class="description">
                AI Formbuilder is currently under construction.
                <br>
                We're putting the pieces together.
            </p>


            <div class="progress-container">

                <div class="progress-label">
                    <span>Building AI Formbuilder</span>
                    <span>In progress</span>
                </div>

                <div class="progress-bar">
                    <div class="progress"></div>
                </div>

            </div>

        </section>


        <footer>
            AI-Formbuilder &copy; 2026
        </footer>

    </main>

</body>
</html>