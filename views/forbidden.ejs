<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access denied | AI-Formbuilder</title>
    <link rel="stylesheet" href="/css/visual-identity.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <main class="auth-shell">
        <header class="afb-wordmark auth-brand" aria-label="AI-Formbuilder">
            <span class="afb-wordmark-ai">AI</span>-Formbuilder
        </header>
        <section class="auth-panel" aria-labelledby="forbidden-title">
            <p class="eyebrow">403</p>
            <h1 id="forbidden-title">Access not available</h1>
            <p class="intro">Your account is not authorized to access this area.</p>
            <a class="text-link" href="/login">Return to sign in</a>
        </section>
        <footer class="auth-footer">AI-Formbuilder &copy; 2026</footer>
    </main>
</body>
</html>